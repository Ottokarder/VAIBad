<?php
// VAIBad - Datenbank-Konfiguration
// Kopieren Sie diese Datei zu config.php und passen Sie die Werte an

// Datenbank-Konfiguration
$host = 'localhost';          // Datenbank-Host (z.B. localhost oder 127.0.0.1)
$dbname = 'vaibad';           // Name der Datenbank
$username = 'root';           // Datenbank-Benutzername
$password = '';               // Datenbank-Passwort

// Basis-URL der Anwendung
// Anpassen an Ihren Server-Pfad (z.B. '/webapp/' oder '/vaibad/')
$base_url = '/webapp/';

// Fehlerbehandlung
// Für die Produktion: error_reporting(0); und display_errors Off
error_reporting(E_ALL);
ini_set('display_errors', 1);

try {
    // PDO-Datenbankverbindung herstellen
    $pdo = new PDO("mysql:host=$host;dbname=$dbname;charset=utf8mb4", $username, $password);
    $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
    $pdo->setAttribute(PDO::ATTR_DEFAULT_FETCH_MODE, PDO::FETCH_ASSOC);
    $pdo->setAttribute(PDO::ATTR_EMULATE_PREPARES, false);
} catch (PDOException $e) {
    die("Datenbankverbindung fehlgeschlagen: " . $e->getMessage());
}

// Hilfsfunktion zur Eingabe-Bereinigung
function sanitizeInput($data) {
    if (is_array($data)) {
        return array_map('sanitizeInput', $data);
    }
    return htmlspecialchars(trim($data), ENT_QUOTES, 'UTF-8');
}

// Hilfsfunktion zur Ausgabe
function escapeOutput($data) {
    return htmlspecialchars($data, ENT_QUOTES, 'UTF-8');
}
